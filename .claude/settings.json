{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Project-level shared settings for BuddyPept. Committed to git. Per-machine overrides go in .claude/settings.local.json (gitignored).",
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit:*)",
      "Bash(git push origin*)",
      "Bash(git pull*)",
      "Bash(git checkout*)",
      "Bash(git branch*)",
      "Bash(git restore*)",
      "Bash(git remote*)",
      "Bash(git fetch*)",
      "Bash(git rebase*)",
      "Bash(git merge:*)",
      "Bash(git stash*)",
      "Bash(gh:*)",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(grep*)",
      "Bash(find*)",
      "Bash(wc*)",
      "Bash(mkdir*)",
      "Bash(cd*)",
      "Bash(pwd)",
      "Bash(echo*)",
      "PowerShell(Get-ChildItem*)",
      "PowerShell(Get-Content*)",
      "PowerShell(Test-Path*)",
      "PowerShell(node --version)",
      "PowerShell(npm --version)",
      "PowerShell(npx --version)",
      "Read(//c/Users/rodss/code/buddypept/**)",
      "Write(//c/Users/rodss/code/buddypept/**)",
      "Edit(//c/Users/rodss/code/buddypept/**)",
      "Glob(*)",
      "Grep(*)"
    ],
    "ask": [
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(npm uninstall*)",
      "Bash(npm publish*)"
    ]
  }
}
