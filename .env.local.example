# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored. Never commit secrets.
#
# These are the seven variables the app actually reads. All seven are also set
# in Vercel Production. CRON_SECRET is locked in the Vercel UI, so rotating it
# means changing it in both places.

# === Supabase ===
# Server-side access only. The service-role key never reaches the client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# === Email (Brevo) ===
# Sends from hello@buddypept.com. Replies route to the inbox below.
BREVO_API_KEY=xkeysib-...
REPLY_TO_EMAIL=buddypept@gmail.com

# === Cron ===
# Authenticates the daily 14:00 UTC "your peptide is live" job.
CRON_SECRET=

# === Admin ===
# Basic Auth password for /admin.
ADMIN_PASSWORD=

# === Analytics ===
NEXT_PUBLIC_GA_ID=G-...

# Note: the Supabase MCP token is separate and does NOT belong here.
# Claude Code does not read .env.local. It lives in .claude/settings.local.json
# under an `env` block. See PROJECT-BRIEF.md section 7.
